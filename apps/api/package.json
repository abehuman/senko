{
	"name": "@senkocode/api",
	"version": "0.1.0",
	"private": true,
	"description": "Senko managed inference API for Cloudflare Workers",
	"type": "module",
	"scripts": {
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy --minify",
		"dev": "wrangler dev",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"hono": "4.13.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260823.1",
		"wrangler": "4.125.0"
	}
}
