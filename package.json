{
	"name": "senko-workspace",
	"version": "0.1.0",
	"private": true,
	"description": "Provider-flexible AI coding agent for Japanese development teams",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/abehuman/senko.git"
	},
	"type": "module",
	"packageManager": "pnpm@10.34.1",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"bench": "pnpm --filter @senkocode/cli build && node benchmarks/cli.mjs",
		"build": "pnpm --filter @senkocode/cli build && pnpm --filter @senkocode/website build",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"dev": "pnpm --filter @senkocode/cli dev",
		"dev:website": "pnpm --filter @senkocode/website dev",
		"format": "biome format --write .",
		"lint": "biome check .",
		"package": "pnpm --filter @senkocode/cli pack",
		"release:check": "pnpm check && pnpm smoke:pack",
		"smoke:pack": "node scripts/package-smoke.mjs",
		"test": "pnpm build && vitest run",
		"test:watch": "pnpm build && vitest",
		"typecheck": "pnpm --filter @senkocode/cli typecheck && pnpm --filter @senkocode/website check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"@types/node": "22.17.2",
		"typescript": "5.9.2",
		"vitest": "3.2.4"
	}
}
